[
  {
    "ruleId": "demo-errors",
    "orgId": "demo",
    "sourceId": "mock-webhook",
    "name": "Errors from monitoring",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        { "field": "level", "op": "in", "value": ["ERROR", "FATAL"] }
      ]
    },
    "severity": "CRITICAL",
    "routing": [],
    "presentation": {
      "title": "{{labels.service}}: {{labels.alertname}}",
      "body": "{{message}} on {{labels.instance}}",
      "fields": ["labels.alertname", "labels.service", "labels.instance", "level"]
    },
    "groupBy": ["labels.service", "labels.alertname"],
    "runbookId": null,
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  },
  {
    "ruleId": "demo-warnings",
    "orgId": "demo",
    "sourceId": "mock-webhook",
    "name": "Warnings from monitoring",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        { "field": "level", "op": "eq", "value": "WARN" }
      ]
    },
    "severity": "WARNING",
    "routing": [],
    "presentation": {
      "title": "{{labels.service}}: {{labels.alertname}}",
      "body": "{{message}}",
      "fields": ["labels.alertname", "labels.service", "labels.instance"]
    },
    "groupBy": ["labels.alertname"],
    "runbookId": null,
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  }
]
