[
  {
    "ruleId": "demo-critical-payments",
    "orgId": "demo",
    "sourceId": "mock-json-api",
    "name": "Payment API failures",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "level",
          "op": "in",
          "value": [
            "ERROR",
            "FATAL"
          ]
        }
      ]
    },
    "severity": "CRITICAL",
    "routing": [
      {
        "channel": "ui",
        "target": {
          "type": "group",
          "id": "grp-payments"
        }
      },
      {
        "channel": "sms",
        "target": {
          "type": "user",
          "id": "demo-david-miller"
        }
      }
    ],
    "presentation": {
      "title": "{{service}} is failing",
      "body": "{{code}}: {{message}} on {{host}}",
      "fields": [
        "service",
        "code",
        "host",
        "http.status",
        "http.latency_ms"
      ]
    },
    "groupBy": [
      "service"
    ],
    "throttle": {
      "perRule": {
        "max": 20,
        "windowSeconds": 300
      }
    },
    "runbookId": "rb-db-timeout",
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  },
  {
    "ruleId": "demo-warning-slow-queries",
    "orgId": "demo",
    "sourceId": "mock-app-log",
    "name": "Slow database queries",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "code",
          "op": "eq",
          "value": "SLOW_QUERY"
        }
      ]
    },
    "severity": "WARNING",
    "routing": [
      {
        "channel": "ui",
        "target": {
          "type": "group",
          "id": "grp-platform"
        }
      }
    ],
    "presentation": {
      "title": "{{service}}: slow queries",
      "body": "{{message}}",
      "fields": [
        "service",
        "host",
        "code"
      ]
    },
    "groupBy": [
      "service"
    ],
    "throttle": {
      "perRule": {
        "max": 20,
        "windowSeconds": 300
      }
    },
    "runbookId": "rb-restart",
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  },
  {
    "ruleId": "demo-info-cache",
    "orgId": "demo",
    "sourceId": "mock-kafka",
    "name": "Cache refreshes",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "kind",
          "op": "eq",
          "value": "CACHE_REFRESH"
        }
      ]
    },
    "severity": "INFO",
    "routing": [],
    "presentation": {
      "title": "{{labels.service}}: cache refreshed",
      "body": "{{message}} ({{labels.pod}})",
      "fields": [
        "labels.service",
        "labels.pod",
        "value"
      ]
    },
    "groupBy": [
      "labels.service"
    ],
    "throttle": null,
    "runbookId": null,
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  },
  {
    "ruleId": "demo-critical-kubernetes",
    "orgId": "demo",
    "sourceId": "mock-kafka",
    "name": "Kubernetes failures",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "level",
          "op": "in",
          "value": [
            "ERROR",
            "FATAL"
          ]
        }
      ]
    },
    "severity": "CRITICAL",
    "routing": [
      {
        "channel": "ui",
        "target": {
          "type": "group",
          "id": "grp-platform"
        }
      }
    ],
    "presentation": {
      "title": "Kubernetes cluster is failing",
      "body": "{{kind}} on {{labels.service}}: {{message}}",
      "fields": [
        "kind",
        "labels.service",
        "labels.pod",
        "labels.namespace"
      ]
    },
    "groupBy": [],
    "throttle": {
      "perRule": {
        "max": 20,
        "windowSeconds": 300
      }
    },
    "runbookId": "rb-restart",
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  }
]
