[
  {
    "ruleId": "demo-errors",
    "orgId": "demo",
    "sourceId": "mock-webhook",
    "name": "Errors from monitoring",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "level",
          "op": "in",
          "value": [
            "ERROR",
            "FATAL"
          ]
        }
      ]
    },
    "severity": "CRITICAL",
    "routing": [],
    "presentation": {
      "title": "{{labels.service}}: {{labels.alertname}}",
      "body": "{{message}} on {{labels.instance}}",
      "fields": [
        "labels.alertname",
        "labels.service",
        "labels.instance",
        "level"
      ]
    },
    "groupBy": [
      "labels.service",
      "labels.alertname"
    ],
    "runbookId": "rb-escalation",
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  },
  {
    "ruleId": "demo-warnings",
    "orgId": "demo",
    "sourceId": "mock-webhook",
    "name": "Warnings from monitoring",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "level",
          "op": "eq",
          "value": "WARN"
        }
      ]
    },
    "severity": "WARNING",
    "routing": [],
    "presentation": {
      "title": "{{labels.service}}: {{labels.alertname}}",
      "body": "{{message}}",
      "fields": [
        "labels.alertname",
        "labels.service",
        "labels.instance"
      ]
    },
    "groupBy": [
      "labels.alertname"
    ],
    "runbookId": null,
    "createdAt": "2026-11-20T21:00:00.000Z",
    "updatedAt": "2026-11-20T21:00:00.000Z"
  },
  {
    "ruleId": "demo-api-errors",
    "orgId": "demo",
    "sourceId": "mock-json-api",
    "name": "Payment API errors",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "level",
          "op": "in",
          "value": [
            "ERROR",
            "FATAL"
          ]
        }
      ]
    },
    "severity": "CRITICAL",
    "routing": [],
    "presentation": {
      "title": "{{service}}: {{code}}",
      "body": "{{message}} on {{host}}",
      "fields": [
        "service",
        "host",
        "code",
        "http.status",
        "http.latency_ms"
      ]
    },
    "groupBy": [
      "service",
      "code"
    ],
    "runbookId": "rb-db-timeout",
    "createdAt": "2026-11-21T00:00:00.000Z",
    "updatedAt": "2026-11-21T00:00:00.000Z"
  },
  {
    "ruleId": "demo-api-slow",
    "orgId": "demo",
    "sourceId": "mock-json-api",
    "name": "Slow payment API requests",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "http.latency_ms",
          "op": "gt",
          "value": 3000
        }
      ]
    },
    "severity": "WARNING",
    "routing": [],
    "presentation": {
      "title": "{{service}}: slow requests",
      "body": "{{http.method}} {{http.path}} took {{http.latency_ms}} ms",
      "fields": [
        "service",
        "http.path",
        "http.latency_ms"
      ]
    },
    "groupBy": [
      "service"
    ],
    "runbookId": null,
    "createdAt": "2026-11-21T00:00:00.000Z",
    "updatedAt": "2026-11-21T00:00:00.000Z"
  },
  {
    "ruleId": "demo-log-errors",
    "orgId": "demo",
    "sourceId": "mock-app-log",
    "name": "Errors in the application log",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "level",
          "op": "in",
          "value": [
            "ERROR",
            "FATAL"
          ]
        }
      ]
    },
    "severity": "WARNING",
    "routing": [],
    "presentation": {
      "title": "{{service}}: {{code}}",
      "body": "{{message}}",
      "fields": [
        "service",
        "host",
        "code",
        "traceId"
      ]
    },
    "groupBy": [
      "service",
      "code"
    ],
    "runbookId": "rb-db-timeout",
    "createdAt": "2026-11-21T00:00:00.000Z",
    "updatedAt": "2026-11-21T00:00:00.000Z"
  },
  {
    "ruleId": "demo-access-5xx",
    "orgId": "demo",
    "sourceId": "mock-access-log",
    "name": "HTTP 5xx at the edge",
    "enabled": true,
    "match": {
      "mode": "all",
      "conditions": [
        {
          "field": "status",
          "op": "gte",
          "value": 500
        }
      ]
    },
    "severity": "WARNING",
    "routing": [],
    "presentation": {
      "title": "HTTP {{status}} on {{path}}",
      "body": "{{method}} {{path}} answered {{status}} in {{requestTime}} s",
      "fields": [
        "method",
        "path",
        "status",
        "requestTime",
        "clientIp"
      ]
    },
    "groupBy": [
      "path",
      "status"
    ],
    "runbookId": "rb-wiki",
    "createdAt": "2026-11-21T00:00:00.000Z",
    "updatedAt": "2026-11-21T00:00:00.000Z"
  },
  {
    "ruleId": "demo-kafka-errors",
    "orgId": "demo",
    "sourceId": "mock-kafka",
