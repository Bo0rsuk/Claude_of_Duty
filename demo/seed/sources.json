  {
    "sourceId": "mock-app-log",
    "orgId": "demo",
    "name": "Order service application log",
    "enabled": true,
    "connector": {
      "type": "http-pull",
      "url": "https://datasource.waw-out.pl/logs",
      "intervalSeconds": 5,
      "cursorParam": "after",
      "cursorFrom": "header:X-Next-After"
    },
    "parser": {
      "format": "regex",
      "eventTime": "timestamp",
      "timeFormat": "yyyy-MM-dd HH:mm:ss,SSS",
      "level": "level",
      "message": "message",
      "pattern": "^(?<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) (?<level>\\w+)\\s+\\[(?<service>[^\\]]+)\\] \\[(?<host>[^\\]]+)\\] \\[trace=(?<traceId>[^\\]]+)\\] (?<code>\\S+) - (?<message>.*)$"
    },
    "ingestToken": null,
    "createdAt": "2026-11-21T00:00:00.000Z",
    "updatedAt": "2026-11-21T00:00:00.000Z"
  },
  {
    "sourceId": "mock-access-log",
    "orgId": "demo",
    "name": "Edge access log",
    "enabled": true,
    "connector": {
      "type": "http-pull",
      "url": "https://datasource.waw-out.pl/logs/access",
      "intervalSeconds": 5,
      "cursorParam": "after",
      "cursorFrom": "header:X-Next-After"
    },
    "parser": {
      "format": "regex",
      "eventTime": "timestamp",
      "timeFormat": "dd/MMM/yyyy:HH:mm:ss Z",
      "pattern": "^(?<clientIp>\\S+) \\S+ \\S+ \\[(?<timestamp>[^\\]]+)\\] \"(?<method>\\S+) (?<path>\\S+) [^\"]*\" (?<status>\\d{3}) (?<bytes>\\d+) \"[^\"]*\" \"(?<userAgent>[^\"]*)\" (?<requestTime>[\\d.]+)$"
    },
    "ingestToken": null,
    "createdAt": "2026-11-21T00:00:00.000Z",
    "updatedAt": "2026-11-21T00:00:00.000Z"
  },
