# Copy to terraform.tfvars and adjust. Everything here is optional:
# with no values the mocks are served over HTTP on the instance's public IP.

# region = "eu-central-1"

# Serves the mocks at https://datasource.<domain_name>.
# domain_name = "example.pl"

# Hosted zone of the domain in Route 53. Leave unset when DNS is managed
# elsewhere and add the A record there yourself.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Ingest endpoint of the application that receives the pushed webhooks.
# webhook_url = "https://api.example.pl/ingest/webhook"

# events_per_second = 2
