# Copy to .env for a local run: cp .env.example .env && docker compose up --build

# ":80" serves plain HTTP. A hostname makes Caddy request a TLS certificate for it.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Hostname that Kafka clients outside docker use to reach the broker.
PUBLIC_HOST=localhost

# Events per second generated by each source.
EVENTS_PER_SECOND=2
KAFKA_TOPIC=infra.events

# Where webhooks are pushed. Empty disables the webhook source.
WEBHOOK_URL=
