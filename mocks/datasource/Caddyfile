# SITE_ADDRESS is ":80" for plain HTTP or a hostname, which makes Caddy
# obtain a TLS certificate for it automatically.
{$SITE_ADDRESS::80} {
	# Kafka REST API (Redpanda HTTP Proxy), e.g. /kafka/topics
	handle_path /kafka/* {
		reverse_proxy redpanda:8082
	}

	handle {
		reverse_proxy generator:8000
	}
}

# The web application's own domain. The frontend is hosted on CloudFront, and
# the root of a domain can only hold an A record, so this instance takes the
# requests and passes them on. Without FRONTEND_ADDRESS the block listens on
# a port that is not published.
{$FRONTEND_ADDRESS::8080} {
	reverse_proxy {$FRONTEND_UPSTREAM:http://generator:8000} {
		header_up Host {upstream_hostport}
	}
}
